# Optional. With a key, field extraction uses Claude (reads text + scanned PDFs).
# Without it, the app runs fully offline with local OCR + a layout-aware rules parser.
ANTHROPIC_API_KEY=

# auto (default: Claude if a key is set) | claude | rules
AP_EXTRACTOR=auto
AP_CLAUDE_MODEL=claude-opus-5-5

# Visual pacing per stage in the live view, in ms (0 = as fast as possible)
AP_STAGE_MIN_MS=450
